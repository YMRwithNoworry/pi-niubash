{
  "name": "@paojiao134/pi-niubash",
  "version": "0.1.0",
  "description": "Route Pi shell tools through Niubash and disable PowerShell tools",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "niubash",
    "shell"
  ],
  "files": [
    "src/index.ts",
    "src/niubash.ts",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
